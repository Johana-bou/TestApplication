{
  "name": "douane-gestion",
  "version": "1.0.0",
  "description": "Application de gestion douaniere - Secteur Extreme-Nord",
  "author": "Direction Generale des Douanes du Cameroun",
  "main": "main.js",
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "cm.douanegestion.app",
    "productName": "DouaneGestion",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "resources/backend",
        "to": "backend",
        "filter": ["**/*"]
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DouaneGestion",
      "include": "installer.nsh"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "category": "Office",
      "maintainer": "DouaneGestion",
      "description": "Application de gestion douaniere"
    },
    "deb": {
      "depends": ["libnotify4", "libxtst6", "libnss3"]
    }
  }
}
